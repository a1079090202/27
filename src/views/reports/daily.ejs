<% const report = view.report; %>
<%- include('../partials/header', { title: '日结 ' + report.date }) %>
<div class="page-head">
  <h1>日结 · <%= report.date %></h1>
  <form method="get" style="display:flex;gap:8px">
    <input type="date" name="date" value="<%= report.date %>" style="width:160px">
    <button class="btn">切换日期</button>
  </form>
</div>

<% if (view.close) { %>
<div class="card" style="border:1px solid <%= view.drift.length ? 'var(--red)' : '#16a34a' %>;background:<%= view.drift.length ? 'var(--red-bg)' : '#f0fdf4' %>">
  <h2>🔒 该日已封账（<%= view.close.closed_by %> · <%= view.close.closed_at %>）</h2>
  <% if (view.drift.length) { %>
    <p style="color:var(--red)"><b>⚠ 封账快照与实时重算不一致（<%= view.drift.length %> 项漂移），已封区间数据被补录/冲改：</b></p>
    <table>
      <tr><th>项目</th><th class="num">封账快照</th><th class="num">当前重算</th></tr>
      <% view.drift.forEach(d => { %>
        <tr>
          <td><%= d.field %></td>
          <td class="num"><%= typeof d.snapshot === 'boolean' ? (d.snapshot?'平':'不平') : d.snapshot %></td>
          <td class="num" style="color:var(--red)"><%= typeof d.current === 'boolean' ? (d.current?'平':'不平') : d.current %></td>
        </tr>
      <% }) %>
    </table>
  <% } else { %>
    <p style="color:#15803d">✓ 封账快照与实时重算一致，封账区间无补录、无冲改。</p>
  <% } %>
</div>
<% } else if (view.canClose && report.allPass) { %>
<div class="card" style="background:#f0fdf4">
  <form method="post" action="/daily/close" style="display:flex;align-items:center;gap:12px">
    <input type="hidden" name="date" value="<%= report.date %>">
    <span>当日对账全部 ✓，可封账固化（封账后该日及以前不可补录回执/退款，更正只能走次日）。</span>
    <button class="btn" style="background:#16a34a;color:#fff">🔒 封账</button>
  </form>
</div>
<% } else if (view.isFuture) { %>
<div class="card" style="background:#fffbeb"><span class="muted">未来日期，不能封账。</span></div>
<% } else if (view.latestCloseDate) { %>
<div class="card" style="background:#fffbeb">
  <span class="muted">该日不在封账链上：账已封至 <b><%= view.latestCloseDate %></b>，下一可封账日为 <b><%= view.nextCloseDate %></b>（支持零业务日封账）。</span>
</div>
<% } %>

<div class="grid grid-4">
  <div class="card kpi cash">
    <div class="label">① 现金净流入</div>
    <div class="value">¥<%= yuan(report.cash.net) %></div>
    <div class="sub">回执收回 ¥<%= yuan(report.cash.in) %> − 退押支出 ¥<%= yuan(report.cash.out) %></div>
    <div class="sub">其中水款 ¥<%= yuan(report.cash.waterPart) %> · 押金 ¥<%= yuan(report.cash.depositPart) %></div>
  </div>
  <div class="card kpi unpaid">
    <div class="label">② 今日新增未收款</div>
    <div class="value">¥<%= yuan(report.unpaid.todayAmount) %></div>
    <div class="sub"><%= report.unpaid.todayOrders %> 单未结清</div>
    <div class="sub">欠水款 ¥<%= yuan(report.unpaid.todayWater) %><% if (report.unpaid.todayDeposit > 0) { %> · <span style="color:var(--red)">欠押金 ¥<%= yuan(report.unpaid.todayDeposit) %></span><% } %></div>
  </div>
  <div class="card kpi deposit">
    <div class="label">③ 押金净变动</div>
    <div class="value">¥<%= yuan(report.deposit.net) %></div>
    <div class="sub">收 ¥<%= yuan(report.deposit.collected) %> − 退 ¥<%= yuan(report.deposit.refunded) %></div>
    <div class="sub">收 <%= report.deposit.collectedQty %> 桶 / 退 <%= report.deposit.refundedQty %> 桶</div>
  </div>
  <div class="card kpi">
    <div class="label">累计未收款（全部）</div>
    <div class="value" style="color:#92400e">¥<%= yuan(report.unpaid.totalAmount) %></div>
    <div class="sub"><%= report.unpaid.totalOrders %> 单挂账</div>
    <div class="sub">欠水款 ¥<%= yuan(report.unpaid.totalWater) %><% if (report.unpaid.totalDeposit > 0) { %> · <span style="color:var(--red)">欠押金 ¥<%= yuan(report.unpaid.totalDeposit) %></span><% } %></div>
  </div>
</div>

<div class="grid grid-4">
  <div class="card kpi">
    <div class="label">空桶·送达收回</div>
    <div class="value"><%= report.empty.recover %></div>
    <div class="sub">回执当场收回</div>
  </div>
  <div class="card kpi">
    <div class="label">空桶·退桶交回</div>
    <div class="value"><%= report.empty.refundIn %></div>
    <div class="sub">客户退桶时交回</div>
  </div>
  <div class="card kpi deposit">
    <div class="label">今日空桶回站</div>
    <div class="value"><%= report.empty.todayTotal %></div>
    <div class="sub"><a href="/buckets?date=<%= report.date %>">空桶台账 →</a></div>
  </div>
  <div class="card kpi">
    <div class="label">账上押金桶抵扣置换</div>
    <div class="value"><%= report.deposit.offsetQty %></div>
    <div class="sub"><%= report.deposit.offsetLines %> 笔抵扣（不退钱，钉源头）</div>
  </div>
</div>

<% if (report.anomalous.length) { %>
<div class="card" style="border:1px solid var(--red);background:var(--red-bg)">
  <h2>⚠ 账实异常客户（<%= report.anomalous.length %>）：累计交回空桶 &gt; 累计接收，有物无账/多报空桶</h2>
  <table>
    <tr><th>客户</th><th>楼栋门牌</th><th class="num">累计接收</th><th class="num">累计交回</th><th class="num">多交</th></tr>
    <% report.anomalous.forEach(a => { %>
      <tr>
        <td><a href="/customers/<%= a.id %>"><%= a.name %></a> <span class="muted"><%= a.code %></span></td>
        <td><%= a.building %> <%= a.room %></td>
        <td class="num"><%= a.out_qty %></td>
        <td class="num"><%= a.returned_qty %></td>
        <td class="num" style="color:var(--red)"><b><%= a.returned_qty - a.out_qty %></b></td>
      </tr>
    <% }) %>
  </table>
</div>
<% } %>

<div class="card">
  <h2>押金余额变动</h2>
  <table>
    <tr><th>期初（昨日末）</th><td class="num"><%= report.deposit.beginQty %> 桶</td><td class="num">¥<%= yuan(report.deposit.beginAmount) %></td></tr>
    <tr><th>今日新收押金</th><td class="num">+<%= report.deposit.collectedQty %> 桶</td><td class="num">+¥<%= yuan(report.deposit.collected) %></td></tr>
    <tr><th>今日退桶退款</th><td class="num">−<%= report.deposit.refundedQty %> 桶</td><td class="num">−¥<%= yuan(report.deposit.refunded) %></td></tr>
    <tr><th><b>期末押金余额（全站客户）</b></th><td class="num"><b><%= report.deposit.endQty %> 桶</b></td><td class="num"><b>¥<%= yuan(report.deposit.endAmount) %></b></td></tr>
  </table>
</div>

<div class="card">
  <h2>自动对账（<%= report.checks.length %> 项，每一分钱、每一只桶钉到源头）</h2>
  <table class="checks">
    <tr><th>核对项</th><th class="num">左值</th><th class="num">右值</th><th>结果</th></tr>
    <% report.checks.forEach(c => { %>
      <tr>
        <td><%= c.name %><% if (c.scope === 'global') { %> <span class="muted" title="反映封账后的当前世界，不参与封账漂移判定">[全库体检]</span><% } %></td>
        <td class="num"><%= c.unit === 'fen' ? '¥'+yuan(c.left) : c.left %></td>
        <td class="num"><%= c.unit === 'fen' ? '¥'+yuan(c.right) : c.right %></td>
        <td class="<%= c.pass ? 'pass':'fail' %>"><%= c.pass ? '✓ 平' : '✗ 不平' %></td>
      </tr>
    <% }) %>
  </table>
  <p style="margin-top:8px">
    <% if (report.allPass) { %><span class="badge ok">本日账务平衡</span><% } else { %><span class="badge warn">有不平项，立即停账排查</span><% } %>
  </p>
</div>

<div class="grid grid-2">
  <div class="card">
    <h2>现金收入明细（回执 <%= report.receipts.length %>）</h2>
    <table>
      <tr><th>回执</th><th>客户</th><th class="num">水款</th><th class="num">押金</th><th class="num">收现</th></tr>
      <% report.receipts.forEach(r => { %>
        <tr>
          <td class="mono"><%= r.receipt_no %></td>
          <td><%= r.customer_name %></td>
          <td class="num">¥<%= yuan(r.cash_collected - r.deposit_amount) %></td>
          <td class="num">¥<%= yuan(r.deposit_amount) %></td>
          <td class="num">¥<%= yuan(r.cash_collected) %></td>
        </tr>
      <% }) %>
      <% if (!report.receipts.length) { %><tr><td colspan="5" class="muted">今日无回执</td></tr><% } %>
    </table>
  </div>
  <div class="card">
    <h2>现金支出明细（退桶 <%= report.refunds.length %>）</h2>
    <table>
      <tr><th>时间</th><th>客户</th><th class="num">桶数</th><th class="num">退款</th><th>收据号</th></tr>
      <% report.refunds.forEach(r => { %>
        <tr>
          <td class="mono"><%= r.occurred_at %></td>
          <td><%= r.customer_name %></td>
          <td class="num"><%= r.qty %></td>
          <td class="num">−¥<%= yuan(r.amount) %></td>
          <td class="mono"><%= r.ref_no || '—' %></td>
        </tr>
      <% }) %>
      <% if (!report.refunds.length) { %><tr><td colspan="5" class="muted">今日无退款</td></tr><% } %>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
